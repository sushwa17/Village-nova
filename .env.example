# ==============================================================================
# VillageNova Environment Template (Copy to .env and populate keys)
# ==============================================================================

# Google Stitch Design-to-Code API
STITCH_API_KEY=your_stitch_api_key_here
STITCH_MCP_URL=https://stitch.googleapis.com/mcp

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Supabase Platform
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/villagenova

# Redis Cache
REDIS_URL=redis://localhost:6379/0
